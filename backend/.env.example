# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret (generate a random string: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Razorpay Configuration (use "skip" values if not available)
RAZORPAY_KEY_ID=rzp_test_skip
RAZORPAY_KEY_SECRET=skip
RAZORPAY_WEBHOOK_SECRET=skip

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@bhashaconnect.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development
PORT=3000

# Platform Commission (18%)
PLATFORM_COMMISSION_RATE=0.18

# Booking Settings
MIN_BOOKING_ADVANCE_HOURS=2
MAX_BOOKING_DAYS_AHEAD=60
PAYMENT_TIMEOUT_MINUTES=15
